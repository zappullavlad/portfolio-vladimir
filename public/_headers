# Header di sicurezza per tutte le pagine (li legge Cloudflare Workers, il file non viene servito).
# Il sito carica solo file propri: script, stili, font e immagini dallo stesso dominio.
# data: nelle immagini serve alla grana di fondo, un SVG scritto dentro style.css.
# Unica eccezione: lo script di Cloudflare Web Analytics (statistiche senza cookie) e il suo invio dei dati.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com/beacon.min.js; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  X-Frame-Options: DENY

# Gli stessi file rispondono anche su questi indirizzi: restano raggiungibili,
# ma i motori di ricerca devono indicizzare solo https://vladzappulla.com
https://portfolio.vladzappulla.com/*
  X-Robots-Tag: noindex

https://:nome.zappullavlad.workers.dev/*
  X-Robots-Tag: noindex

# i font non cambiano mai nome finché non li cambio io: il browser può tenerli a lungo
/font/*
  Cache-Control: public, max-age=31536000, immutable
